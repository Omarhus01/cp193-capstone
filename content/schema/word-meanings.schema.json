{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "wordMeanings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "word": { "type": "string", "pattern": "^[1-9]\\d{0,2}:[1-9]\\d{0,2}:[1-9]\\d{0,2}$" },
          "meaning": {
            "type": "object",
            "properties": {
              "en": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
              "ko": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] }
            },
            "required": ["en", "ko"],
            "additionalProperties": false,
            "description": "English and Korean. null until written."
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "A stable id, such as \"001-reading-1\". Never reuse one for something else."
            },
            "description": "Ids of passages in content/sources/, in the order they are shown."
          },
          "status": {
            "type": "string",
            "enum": ["draft", "en_approved", "ko_drafted", "ko_approved", "published"],
            "description": "Must be where the review history ends (draft when it's empty)."
          },
          "review": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": ["draft", "en_approved", "ko_drafted", "ko_approved", "published"]
                },
                "reviewer": { "type": "string", "minLength": 1 },
                "date": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                },
                "notes": { "type": "string", "minLength": 1 }
              },
              "required": ["status", "reviewer", "date"],
              "additionalProperties": false,
              "description": "One review step. Sending an item back to an earlier step needs notes."
            }
          }
        },
        "required": ["word", "meaning", "citations", "status", "review"],
        "additionalProperties": false
      }
    }
  },
  "required": ["wordMeanings"],
  "additionalProperties": false
}
