{
  "name": "cp193-capstone",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "start": "npm run start -w apps/web",
    "lint": "npm run lint -w apps/web",
    "typecheck": "npm run typecheck -w apps/web",
    "test": "npm run test -w apps/web",
    "test:e2e": "npm run test:e2e -w apps/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "content:schema": "npm run content:schema -w apps/web",
    "content:import-tanzil": "npm run content:import-tanzil -w apps/web --",
    "content:import-tanzil-metadata": "npm run content:import-tanzil-metadata -w apps/web --",
    "content:seed": "npm run content:seed -w apps/web"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "supabase": "^2.121.0"
  }
}
